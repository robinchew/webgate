{
    http_port 8000
    https_port {$PUBLIC_PORT}
}
localhost:{$PUBLIC_PORT} {
    handle /importEnv.js {
        header Content-Type application/javascript
        respond <<JS
            const importEnv = () => ({
                PUBLIC_PORT: {$PUBLIC_PORT}
            });
        JS
    }
    @server_paths {
        path /home-battery-sse /ws/* /sse/* /api/*
    }
    handle @server_paths {
        reverse_proxy 127.0.0.1:{$SERVER_PORT}
    }
    handle {
        root * {$FRONTEND_ROOT}
         # Try the exact path, then the path as a directory (for index.html), then 404/API
        try_files {path} {path}.html {path}/index.html
        
        # Serve the file found by try_files
        file_server
    }
}

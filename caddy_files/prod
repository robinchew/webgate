gate.robin.au, home.robin.au, 103.224.52.13, 192.168.1.69 {
    root * {$FRONTEND_ROOT}
    log {
        output stdout
    }
    handle /importEnv.js {
        header Content-Type application/javascript
        respond <<JS
            const importEnv = () => ({
                PUBLIC_PORT: 443
            });
        JS
    }
    @server_paths {
        path /home-battery-sse /ws/* /sse/* /api/*
    }
    handle @server_paths {
        reverse_proxy 127.0.0.1:{$SERVER_PORT}
    }
    handle {
        root * {$FRONTEND_ROOT}
         # Try the exact path, then the path as a directory (for index.html), then 404/API
        try_files {path} {path}.html {path}/index.html
        
        # Serve the file found by try_files
        file_server
    }
}

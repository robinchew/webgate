(serve_static) {
    root * {$FRONTEND_ROOT}
     # Try the exact path, then the path as a directory (for index.html), then 404/API
    try_files {path}.html {path}/index.html

    # Serve the file found by try_files
    file_server
}
gate.robin.au, home.robin.au, 103.224.52.13, 192.168.1.69 {
    root * {$FRONTEND_ROOT}
    log {
        output stdout
    }
    handle /importEnv.js {
        header Content-Type application/javascript
        respond <<JS
            const importEnv = () => ({
                PUBLIC_PORT: 443
            });
        JS
    }
    handle / {
        import serve_static
    }
    handle /home-battery {
        import serve_static
    }
    handle {
        reverse_proxy 127.0.0.1:{$SERVER_PORT}
    }
}
